# Banco de dados Postgres.
# DATABASE_URL = conexão pooled (usada pela aplicação em tempo de execução)
# DATABASE_URL_UNPOOLED = conexão direta (usada para migrações do Prisma)
DATABASE_URL="postgresql://usuario:senha@host-pooler.exemplo.com/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.exemplo.com/banco?sslmode=require"

# Chave usada para assinar o cookie de sessão. Gere uma nova com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Chave da API do Resend (https://resend.com/api-keys), usada para enviar
# o e-mail de recuperação de senha.
RESEND_API_KEY=""
