# Banco de dados Postgres.
# DATABASE_URL = conexão pooled (usada pela aplicação em tempo de execução)
# DATABASE_URL_UNPOOLED = conexão direta (usada para migrações do Prisma)
DATABASE_URL="postgresql://usuario:senha@host-pooler.exemplo.com/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.exemplo.com/banco?sslmode=require"

# Chave usada para assinar o cookie de sessão. Gere uma nova com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Chave da API do Resend (https://resend.com/api-keys), usada para enviar
# o e-mail de recuperação de senha.
RESEND_API_KEY=""

# Chave da API da Anthropic (https://console.anthropic.com/settings/keys),
# usada pelo Assistente IA para responder perguntas sobre os dados financeiros.
ANTHROPIC_API_KEY=""

# Conexão bancária (Open Finance) — ver docs/OPEN_FINANCE.md.
# Deixe tudo em branco para usar o MockBankProvider (dados simulados,
# padrão fora de produção). Em produção, sem essas 4 variáveis, o recurso
# fica desabilitado — nunca cai silenciosamente em dados simulados.
OPEN_FINANCE_CLIENT_ID=""
OPEN_FINANCE_CLIENT_SECRET=""
OPEN_FINANCE_BASE_URL=""
OPEN_FINANCE_REDIRECT_URI="http://localhost:3000/api/open-finance/callback"
